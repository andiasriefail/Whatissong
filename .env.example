# Telegram Bot Token (dari @BotFather)
BOT_TOKEN=your_bot_token_here

# AudD API Keys — bisa sampai 3 key, otomatis fallback jika satu habis kuota
AUDD_API_KEY_1=your_audd_key_1
AUDD_API_KEY_2=your_audd_key_2
AUDD_API_KEY_3=your_audd_key_3

# Web API Key untuk autentikasi endpoint /recognize
WEB_API_KEY=your_secret_api_key

# Cloudflare Pages origin (untuk CORS, opsional)
CF_PAGES_ORIGIN=https://yoursite.pages.dev

# Port (diisi otomatis oleh Render, tidak perlu diubah)
# API_PORT=5000
